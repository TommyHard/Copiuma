{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      },
      "music-route": {
        "ClusterId": "music-cluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": {
          "Path": "/api/music/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/music" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://localhost:5001" }
        }
      },
      "music-cluster": {
        "Destinations": {
          "destination1": { "Address": "https://localhost:5002" }
        }
      }
    }
  },
  "JwtSettings": {
    "Key": "C0piuma_Super_Secret_Security_Key_2077",
    "Issuer": "Copiuma.Identity",
    "Audience": "Copiuma.Clients"
  }
}